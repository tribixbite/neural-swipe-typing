{
  "name": "swipe-typing-demo",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run build.ts && concurrently \"bun run build.ts --watch\" \"bun --hot server.ts\"",
    "server": "bun --hot server.ts",
    "build": "bun run build.ts",
    "build:watch": "bun run build.ts --watch",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/bun": "latest",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.55.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5"
  },
  "dependencies": {
    "onnxruntime-node": "^1.22.0-rev",
    "onnxruntime-web": "^1.16.3"
  }
}
